# Copy this file to .env.local and fill in the web app config from
# Firebase console > Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orvena-website.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orvena-website
VITE_FIREBASE_STORAGE_BUCKET=orvena-website.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
