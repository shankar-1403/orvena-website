rules_version = '2';

// Contact-form enquiries: anyone may submit one (checked field by field below);
// only admins may read, update the status of, or delete them.
// An admin is a signed-in user with a document at /admins/{their uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'mobile', 'topic', 'condition', 'message', 'status', 'source', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.mobile is string && request.resource.data.mobile.size() <= 20
        && request.resource.data.topic in ['healthos', 'clinicos', 'reversal', 'other']
        && request.resource.data.condition is string && request.resource.data.condition.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() <= 4000
        && request.resource.data.source is string && request.resource.data.source.size() <= 200
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read', 'handled'];
    }

    // A signed-in user may check whether they are an admin; nobody can write here
    // from the site. Admins are added in the Firebase console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
